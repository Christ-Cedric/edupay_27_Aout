<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Android 9+ (API 28) bloque le trafic HTTP en clair par defaut. Le
         backend de dev tourne en `http://<IP LAN>:3000`, donc sans cette ligne
         chaque appel echoue par `CLEARTEXT communication to ... not permitted`.
         Volontairement limite a la variante debug : la release reste en
         HTTPS-seulement. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
