# Copier en `.env` et adapter. Ne jamais committer `.env`.

NODE_ENV=development
PORT=3000

# PostgreSQL 16 (voir docker-compose.yml)
DATABASE_URL="postgresql://edupay:edupay@localhost:5432/edupay?schema=public"

# Redis (cache + files BullMQ, plus tard)
REDIS_URL="redis://localhost:6379"

# JWT (contrat §2.2) — access court, refresh long. Générer des secrets forts.
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Inscription client par OTP (§2) — secret distinct de JWT_ACCESS_SECRET.
JWT_SCOPE_SECRET="change-me-scope-secret"
JWT_SCOPE_TTL="15m"
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# true en dev/test uniquement — ne jamais activer en production.
OTP_DEV_EXPOSE=true

# Compte admin seedé au premier `db:seed` (contrat §2.1 — admin par défaut).
SEED_ADMIN_PHONE="+22676691911"
SEED_ADMIN_PASSWORD="change-me-admin"
SEED_ADMIN_NAME="DERRA Bassirou"

# WhatsApp Business Cloud — canal réel des notifications (reçu, livraison,
# relance retard) et de l'OTP client. Optionnelles : sans elles, échec
# explicite (notification marquée en erreur), jamais un crash.
WHATSAPP_API_URL="https://graph.facebook.com/v17.0"
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DIRECTOR_NUMBER=

# Africa's Talking (SMS) — implémentée mais volontairement non appelée par le
# code d'envoi actuel (réservée à une activation future, scope OTP client).
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME="sandbox"

# Firebase Cloud Messaging (push) — canal réel EN PLUS de WhatsApp pour les
# notifications déjà câblées. Console Firebase → Paramètres du projet →
# Comptes de service → Générer une nouvelle clé privée (JSON) → reporter
# project_id/client_email/private_key ici (garder les \n littéraux de la clé).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
